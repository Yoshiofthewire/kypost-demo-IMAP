# Copy to .env. Never commit the real file.
#
#   cp .env.example .env

# --- required ---------------------------------------------------------------

# Cloudflare Tunnel token. Deployment secret: it is injected into the
# cloudflared container at runtime and is never baked into an image, a Compose
# file under version control, or the mail server's seed data.
CLOUDFLARED_TUNNEL_TOKEN=

# --- reset mode -------------------------------------------------------------
#
# App Store testing configuration (the default): both lines left as they are.
# The reset endpoint answers 403 and no state can be wiped.
RESET_ENABLED=false
RESET_TOKEN=

# Demo configuration: uncomment both. The token must be at least 16 characters
# and the server refuses to start with reset enabled and a weaker token.
#RESET_ENABLED=true
#RESET_TOKEN=change-me-to-a-long-random-string

# --- optional ---------------------------------------------------------------

PUBLIC_URL=https://demo.kypost.org

# Which seeded persona KyPost Server logs into by default: alice, bob, charlie.
DEMO_PERSONA=alice
DEMO_PASSWORD=demo

TZ=UTC

# KyPost-Net addressing. Change these together if 172.30.0.0/24 collides with
# something on your host; no application code has to change.
KYPOST_NET_SUBNET=172.30.0.0/24
KYPOST_NET_GATEWAY=172.30.0.1
KYPOST_SERVER_IP=172.30.0.10
KYPOST_DEMO_MAIL_IP=172.30.0.20
CLOUDFLARED_IP=172.30.0.30

# Ambient delivery interval override, in seconds. 0 (default) means the normal
# random 15-30 minute interval. The acceptance suite sets this to 2.
DRIP_SECONDS=0

# Ceiling on dynamically created mailboxes. The server accepts any login, so
# this bounds what an unknown client can allocate.
MAX_PERSONAS=100
